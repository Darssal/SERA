# Copy to .env locally. Never commit real credentials.
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=zai-org/GLM-5.3-Flash
SERA_PUBLIC_ORIGIN=http://127.0.0.1:8080
SERA_ASR_WS_URL=ws://127.0.0.1:8080/asr/ws
SERA_SITE_ADDRESS=:80
SERA_BIND=127.0.0.1
SERA_HTTP_PORT=8080
SERA_HTTPS_PORT=8443
SERA_MAIL_MODE=local
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=starttls
VAPID_SUBJECT=mailto:admin@example.test
# Explicit operator-owned user IDs only; never a public registration option.
SERA_COMMUNITY_OFFICIAL_USER_IDS=
