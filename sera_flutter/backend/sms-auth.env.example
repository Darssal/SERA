# Copy into sera_flutter/.local/sms-auth.env. Do not place real RAM keys here.
# SMS remains explicitly unavailable until enabled and completely configured.
SERA_SMS_AUTH_ENABLED=false
SERA_SMS_ACCESS_KEY_ID=
SERA_SMS_ACCESS_KEY_SECRET=
# Optional RAM STS session token; leave blank when using a dedicated RAM key.
SERA_SMS_SECURITY_TOKEN=
# Select the complimentary signature shown in your PNVS console.
SERA_SMS_SIGN_NAME=
# Namespace used to derive a distinct <=20-character provider scheme per challenge.
SERA_SMS_SCHEME_NAME=SERA
SERA_SMS_TEMPLATE_LOGIN=100001
SERA_SMS_TEMPLATE_BIND=100004
SERA_SMS_TEMPLATE_SENSITIVE=100005
# During controlled integration enter ONLY the explicitly authorized test phone.
# Comma-separated mainland numbers; blank removes this additional restriction.
SERA_SMS_ALLOWED_TEST_PHONES=
# Reservations count even when a provider call fails or times out.
SERA_SMS_PHONE_HOUR_LIMIT=5
SERA_SMS_PHONE_DAY_LIMIT=10
SERA_SMS_IP_MINUTE_LIMIT=5
SERA_SMS_IP_HOUR_LIMIT=20
SERA_SMS_GLOBAL_HOUR_LIMIT=50
SERA_SMS_GLOBAL_DAY_LIMIT=100
